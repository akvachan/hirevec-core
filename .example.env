# Server's URL.
HIREVEC_URL=http://localhost:8888

# PostgreSQL URL.
HIREVEC_POSTGRESQL_URL=postgresql://postgres@localhost:5432

# Log level.
# Valid values are DEBUG, INFO, WARN, ERROR.
HIREVEC_LOG_LEVEL=INFO

# Produce logs in JSON format.
HIREVEC_LOG_JSON=false

# Request read timeout.
# Valid time units are "ns", "us", "ms", "s", "m", "h".
HIREVEC_REQUEST_READ_TIMEOUT=1s

# Request write timeout.
# Valid time units are "ns", "us", "ms", "s", "m", "h".
HIREVEC_REQUEST_WRITE_TIMEOUT=1s

# Graceful server shutdown period.
# Valid time units are "ns", "us", "ms", "s", "m", "h".
HIREVEC_GRACE_PERIOD=5s

# Embeddings job frequency.
# Valid time units are "ns", "us", "ms", "s", "m", "h".
HIREVEC_EMBEDDINGS_JOB_FREQUENCY=1h

# Recommendations job frequency.
# Valid time units are "ns", "us", "ms", "s", "m", "h".
HIREVEC_RECOMMENDATIONS_JOB_FREQUENCY=12h

# llama-cpp server URL.
HIREVEC_LLAMACPP_URL=http://localhost:9931

# llama-cpp server API key.
HIREVEC_LLAMACPP_API_KEY=

# llama-cpp embeddings model.
HIREVEC_LLAMACPP_EMBEDDINGS_MODEL=jinaai/jina-embeddings-v5-text-nano-retrieval-GGUF:Q8_0

# llama-cpp reranker model.
HIREVEC_LLAMACPP_RERANKER_MODEL=mradermacher/jina-reranker-v1-tiny-en-GGUF:Q8_0

# Embeddings dimensionality.
HIREVEC_LLAMACPP_EMBEDDINGS_DIM=768

# Symmetric key for refresh token encryption.
# Auto-populated if empty.
HIREVEC_SYMMETRIC_KEY=

# Asymmetric key for access token encryption.
# Auto-populated if empty.
HIREVEC_ASYMMETRIC_KEY=

# Development mode.
# Allows to start server with some data pre-ingested.
HIREVEC_DEVELOPMENT_MODE=false

# Tokens will never expire in development mode.
HIREVEC_DEVELOPMENT_MODE_TOKENS_NEVER_EXPIRE=false

# Drop tables when stopping server in development mode.
HIREVEC_DEVELOPMENT_MODE_DROP_TABLES_ON_EXIT=false

# Full name of the development user.
HIREVEC_DEVELOPMENT_MODE_USER_FULL_NAME=Alex Chen

# User name of the development user.
HIREVEC_DEVELOPMENT_MODE_USER_NAME=alexchen

# Email of the development user.
HIREVEC_DEVELOPMENT_MODE_USER_EMAIL=alex.chen@example.com

# Password of the development user.
HIREVEC_DEVELOPMENT_MODE_USER_PASSWORD=
