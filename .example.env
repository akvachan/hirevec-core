# Server's base URL.
HIREVEC_BASE_URL=localhost:8888

# Log level.
# Valid values are DEBUG, INFO, WARN, ERROR.
HIREVEC_LOG_LEVEL=INFO

# Request read timeout.
# Valid time units are "ns", "us", "ms", "s", "m", "h".
HIREVEC_REQUEST_READ_TIMEOUT=1s

# Request write timeout.
# Valid time units are "ns", "us", "ms", "s", "m", "h".
HIREVEC_REQUEST_WRITE_TIMEOUT=1s

# Graceful server shutdown period.
# Valid time units are "ns", "us", "ms", "s", "m", "h".
HIREVEC_GRACE_PERIOD=5s

# Embeddings job frequency.
# Valid time units are "ns", "us", "ms", "s", "m", "h".
HIREVEC_EMBEDDINGS_JOB_FREQUENCY=1h

# Recommendations job frequency.
# Valid time units are "ns", "us", "ms", "s", "m", "h".
HIREVEC_RECOMMENDATIONS_JOB_FREQUENCY=12h

# Symmetric key for refresh token encryption.
# Auto-populated if empty.
HIREVEC_SYMMETRIC_KEY=

# Asymmetric key for access token encryption.
# Auto-populated if empty.
HIREVEC_ASYMMETRIC_KEY=

# Quick start mode.
# Allows to start server with some data pre-ingested.
HIREVEC_QUICK_START=false
