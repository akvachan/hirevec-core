# Hirevec core server base URL
HIREVEC_BASE_URL=

# Symmetric key for refresh token encryption  (in hex format)
# Auto-populated if empty
# Can be generated via `openssl rand -hex 32`
HIREVEC_SYMMETRIC_KEY=

# Asymmetric key for access token encryption (in hex format)
# Auto-populated if empty
# Can be generated via `go run cmd/asymk/main.go`
HIREVEC_ASYMMETRIC_KEY=

# Hirevec development API key (refresh token)
# Auto-populated on `go run cmd/dev/main.go`
HIREVEC_API_KEY=

# Log level
HIREVEC_LOG_LEVEL=

# Postgres URL
POSTGRES_DATABASE_URL=

# TEI Base URL
TEI_BASE_URL=

# TEI API Key
TEI_API_KEY=

# SMTP URL
SMTP_URL=
