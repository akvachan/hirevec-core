# Server
HIREVEC_BASE_URL=localhost:8888

# Timeouts (Go duration strings)
HIREVEC_REQUEST_READ_TIMEOUT=2000ms
HIREVEC_REQUEST_WRITE_TIMEOUT=2000ms
HIREVEC_GRACE_PERIOD=5000ms

# Logging
# Options: DEBUG, INFO, WARN, ERROR
HIREVEC_LOG_LEVEL=DEBUG

# Symmetric key for refresh token encryption.
# Can be generated via `openssl rand -hex 32`.
# Auto-populated if empty.
HIREVEC_SYMMETRIC_KEY=replace_me_with_secure_random_string

# Asymmetric key for access token encryption.
# Can be generated via `go run cmd/create_asymmetric_key/main.go`.
# Auto-populated if empty.
HIREVEC_ASYMMETRIC_KEY=replace_me_with_private_or_public_key_material
